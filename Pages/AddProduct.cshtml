@page
@model FlennikenJack_UT.Pages.AddProductModel
@{
}

<form method="post">
	<div class="form-group">
		<label>Name</label>
		<input type="text" class="form-control" id="Name" asp-for="product.ProductName" required />
	</div>

	<div class="form-group">
		<label>Category</label>
		<textarea class="form-control" id="Category" asp-for="product.Category" required>
		</textarea>
	</div>

	<div class="form-group">
		<label>Price</label>
		<input type="number" step="0.01" class="form-control" id="Price" asp-for="product.Price" required />
	</div>
	<div class="form-group">
		<label>Stock Quantity</label>
		<input type="number" class="form-control" id="Price" asp-for="product.StockQuantity" required />
	</div>

	<button type="submit" class="btn-primary">Add Product</button>

</form>

<a href="/Products/Index">Back to Products</a>

